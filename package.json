{
  "name": "reversa",
  "version": "1.3.3",
  "private": true,
  "description": "ReversaFeynman: independent MarceloClaro edition with evidence, Feynman gates and teach-back",
  "bin": {
    "reversa": "bin/reversa.js"
  },
  "type": "module",
  "scripts": {

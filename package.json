    "codex",
    "gemini",
    "cursor",
    "agents"
  ],
  "files": [
    "agents/",
    "bin/",
    "lib/",
    "templates/",
    "README.md",
    "LICENSE"
  ],
  "author": "Marcelo Claro Laranjeira",
  "contributors": [
    "sandeco (original Reversa project)"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MarceloClaro/reversaFeynman.git"
  },
  "homepage": "https://github.com/MarceloClaro/reversaFeynman",
  "bugs": {
    "url": "https://github.com/MarceloClaro/reversaFeynman/issues"
  },
  "engines": {
    "node": ">=18.20.2"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "inquirer": "^9.2.0",
    "ora": "^7.0.1",
    "semver": "^7.6.0"
  }
